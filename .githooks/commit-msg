#!/usr/bin/env bash
set -euo pipefail

msg_file="$1"
subject="$(head -n 1 "$msg_file")"

# Allow merge commits generated by Git.
if [[ "$subject" =~ ^Merge\  ]]; then
  exit 0
fi

# Conventional Commits with optional scope and breaking marker.
# Also allow autosquash prefixes used during interactive rebase.
pattern='^(fixup! |squash! )?(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?(!)?: .+'

if [[ ! "$subject" =~ $pattern ]]; then
  echo "[commit-msg] Invalid commit message:"
  echo "  $subject"
  echo
  echo "Expected: <type>(<scope>)?: <summary>"
  echo "Examples:"
  echo "  feat(producer): add batch DLQ fallback"
  echo "  fix: prevent offset commit on route failure"
  echo "Allowed types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
  exit 1
fi
