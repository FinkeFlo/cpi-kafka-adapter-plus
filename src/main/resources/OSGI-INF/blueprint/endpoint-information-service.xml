<?xml version="1.0" encoding="UTF-8"?>
<!--
  Registers CpiKafkaPlusEndpointInformationService as an OSGi Blueprint service, implementing
  com.sap.it.api.adapter.monitoring.AdapterEndpointInformationService.

  SPIKE NOTE: this is the feasibility probe for SAP CPI's "endpoint visualization" feature (see
  the endpoint-visualization feature plan). Do not extend the underlying bean with real
  broker/topic/live-status data before the spike confirms CPI actually surfaces this data in its
  monitoring UI for a polling adapter of this kind. If the spike shows no effect, this file and
  the corresponding Java class should be removed rather than built out further.
-->
<blueprint xmlns="http://www.osgi.org/xmlns/blueprint/v1.0.0"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="
               http://www.osgi.org/xmlns/blueprint/v1.0.0 http://www.osgi.org/xmlns/blueprint/v1.0.0/blueprint.xsd">

    <bean id="cpiKafkaPlusEndpointInformationService"
          class="com.finkeflo.cpi.kafka.CpiKafkaPlusEndpointInformationService" />

    <service id="cpiKafkaPlusEndpointInformationServiceRegistration"
             ref="cpiKafkaPlusEndpointInformationService"
             interface="com.sap.it.api.adapter.monitoring.AdapterEndpointInformationService" />

</blueprint>
